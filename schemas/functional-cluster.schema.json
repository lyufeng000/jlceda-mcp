{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlceda-mcp.local/schemas/functional-cluster.schema.json",
  "title": "JLCEDA_Pro_Functional_Cluster_Output",
  "type": "object",
  "required": [
    "schema_version",
    "board_outline",
    "functional_clusters",
    "inter_cluster_edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "1.0.0"
    },
    "board_outline": {
      "type": "object",
      "required": ["shape", "width_mm", "height_mm", "layer_count"],
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["RECTANGLE", "POLYGON"]
        },
        "width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "layer_count": { "type": "integer", "minimum": 1 },
        "copper_weight_outer_oz": { "type": "number", "exclusiveMinimum": 0 },
        "stackup": {
          "type": "array",
          "items": { "type": "string" }
        },
        "polygon_mm": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "fixed_mechanicals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "x_mm", "y_mm", "keepout_dia_mm"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "x_mm": { "type": "number" },
              "y_mm": { "type": "number" },
              "keepout_dia_mm": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "rigid_edge_anchors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "functional_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "module_type",
          "semantic_label",
          "anchor_designator",
          "edge_affinity",
          "estimated_area_mm2",
          "noise_role",
          "members"
        ],
        "properties": {
          "cluster_id": { "type": "string" },
          "module_type": {
            "type": "string",
            "enum": [
              "DCDC_POWER_STAGE",
              "LDO_REGULATOR",
              "MCU_DIGITAL_CORE",
              "CLOCK_OSCILLATOR",
              "PRECISION_ANALOG_FE",
              "HIGH_SPEED_IO_ESD",
              "RF_ANTENNA_BLOCK",
              "ELECTROMECH_DRIVER"
            ]
          },
          "semantic_label": { "type": "string" },
          "anchor_designator": { "type": "string" },
          "edge_affinity": {
            "type": "string",
            "enum": ["LEFT_EDGE", "RIGHT_EDGE", "TOP_EDGE", "BOTTOM_EDGE", "CORNER", "CENTER", "NONE"]
          },
          "estimated_area_mm2": { "type": "number", "minimum": 0 },
          "noise_role": { "type": "string" },
          "thermal_power_w": { "type": "number", "minimum": 0 },
          "max_voltage_v": { "type": "number" },
          "sub_satellites": {
            "type": "array",
            "items": { "type": "string" }
          },
          "datasheet_layout_example": {
            "type": "object",
            "required": ["has_reference_layout"],
            "properties": {
              "has_reference_layout": { "type": "boolean" },
              "source_section": { "type": "string" },
              "reference_image_uri": { "type": "string" },
              "copper_zones": {
                "type": "array",
                "items": { "type": "string" }
              },
              "thermal_via_array": {
                "type": "object",
                "properties": {
                  "epad_pin": { "type": "string" },
                  "grid_rows": { "type": "integer", "minimum": 1 },
                  "grid_cols": { "type": "integer", "minimum": 1 },
                  "drill_mm": { "type": "number", "exclusiveMinimum": 0 },
                  "pitch_mm": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "sensitive_route_constraints": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "keepout_zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["layerSet", "disallowMask", "allowedNets", "mountSide"],
              "properties": {
                "target": { "type": "string" },
                "type": { "type": "string" },
                "polygon2D": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "number" }
                  }
                },
                "layerSet": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "disallowMask": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": ["COPPER_POUR", "TRACK", "VIA", "PAD", "COMPONENT"]
                  }
                },
                "allowedNets": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "mountSide": {
                  "type": "string",
                  "enum": ["TOP", "BOTTOM", "ALL"]
                }
              }
            }
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["designator", "footprint", "role", "bbox_mm"],
              "properties": {
                "designator": { "type": "string" },
                "footprint": { "type": "string" },
                "role": { "type": "string" },
                "bbox_mm": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number", "minimum": 0 }
                },
                "clearance_front_mm": { "type": "number", "minimum": 0 },
                "target_anchor": { "type": "string" },
                "target_pin": { "type": "string" },
                "target_pins": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "max_dist_mm": { "type": "number", "minimum": 0 },
                "zero_stub": { "type": "boolean" },
                "same_layer_mandatory": { "type": "boolean" },
                "power_order": { "type": "string" },
                "guard_ring": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "inter_cluster_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "nets", "signal_class", "weight"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "nets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "signal_class": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
